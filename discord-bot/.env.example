# ==========================================
# KONFIGURACE DISCORD BOTA PRO OPS PORTÁL
# ==========================================

# 1. Token vašeho bota (z Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=sem_vloz_token_bota

# 2. Client ID / Application ID bota (z Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=sem_vloz_client_id

# 3. ID vašeho třídního Discord serveru (Pravý klik na server -> Copy Server ID)
# Díky Guild ID se lomítkové příkazy (/novy-modul, /update) zaregistrují IHNED bez čekání!
GUILD_ID=sem_vloz_guild_id

# 4. ID kanálu, kam má bot posílat veřejná oznámení (Pravý klik na kanál -> Copy Channel ID)
ANNOUNCEMENT_CHANNEL_ID=sem_vloz_channel_id

# 5. Oprávněné osoby (Kdo může příkazy spouštět)
# Můžete uvést ID uživatelů oddělená čárkou (Pravý klik na profil -> Copy User ID).
# Pokud necháte prázdné, příkazy budou moci používat jen uživatelé s právem "Správce serveru" (Administrator).
ALLOWED_USER_IDS=sem_vloz_user_id_1,sem_vloz_user_id_2

# 6. Webová URL vašeho OPS portálu (volitelné pro odkazy v oznámení)
PORTAL_URL=https://deepycat.github.io/well_ops
